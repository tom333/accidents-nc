# Environnement (development ou production)
# En dev, on utilise le même DuckLake distant que prod
ENV=production

# PostgreSQL (catalog DuckLake) - DISTANT
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=data
POSTGRES_USER=data
POSTGRES_PASSWORD=data
POSTGRES_URL=postgresql://data:data@localhost:5432/data

# S3 Storage (RustFS) - DISTANT
S3_ENDPOINT=https://rustfs.tgu.ovh
S3_BUCKET=accidents-bucket
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin

# Note: Dev et prod utilisent le même DuckLake
# Seule différence: ENV=development ou ENV=production
DAGSTER_HOME=/home/moi/projets/perso/accidents/dagster_home
