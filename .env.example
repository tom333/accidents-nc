# Environnement (development ou production)
# En dev, on utilise le même DuckLake distant que prod
ENV=development

# PostgreSQL (catalog DuckLake) - DISTANT
POSTGRES_HOST=postgresql.datalab.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=data
POSTGRES_USER=dagster
POSTGRES_PASSWORD=<your-password>
POSTGRES_URL=postgresql://dagster:<your-password>@postgresql.datalab.svc.cluster.local:5432/data

# S3 Storage (RustFS) - DISTANT
S3_ENDPOINT=https://rustfs.tgu.ovh
S3_BUCKET=accidents-bucket
AWS_ACCESS_KEY_ID=<your-key>
AWS_SECRET_ACCESS_KEY=<your-secret>

# Note: Dev et prod utilisent le même DuckLake
# Seule différence: ENV=development ou ENV=production
