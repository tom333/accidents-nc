# syntax=docker/dockerfile:1.4

# ============================================
# Stage 1: Builder - install deps with uv
# ============================================
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install deps without the project to maximize caching
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --extra api

# Copy project files
COPY --link . /app

# Install project with api extra
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra api

# ============================================
# Stage 2: Runtime - minimal production image
# ============================================
FROM python:3.12-slim-bookworm

# Create non-root user
RUN groupadd --system --gid 1000 api && \
    useradd --system --gid 1000 --uid 1000 --create-home api

WORKDIR /app

# Copy only the virtual environment and required sources/artifacts
COPY --from=builder --chown=api:api /app/.venv /app/.venv
COPY --from=builder --chown=api:api /app/src /app/src
COPY --from=builder --chown=api:api /app/apps/api /app/apps/api

# Stateless image: models are downloaded at pod startup by an init container
RUN mkdir -p /app/models && chown api:api /app/models

# Ensure the venv is used by default
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER api

# Expose FastAPI port
EXPOSE 8000

# Run Uvicorn
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
