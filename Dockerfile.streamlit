# syntax=docker/dockerfile:1.4

# ============================================
# Stage 1: Builder - install deps with uv
# ============================================
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=0

WORKDIR /app

# Build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install deps without the project to maximize caching
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --extra streamlit

# Copy project files
COPY --link . /app

# Install project with streamlit extra
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra streamlit

# ============================================
# Stage 2: Runtime - minimal production image
# ============================================
FROM python:3.12-slim-bookworm

# Create non-root user
RUN groupadd --system --gid 1000 streamlit && \
    useradd --system --gid 1000 --uid 1000 --create-home streamlit

WORKDIR /app

# Copy only the virtual environment and app sources
COPY --from=builder --chown=streamlit:streamlit /app/.venv /app/.venv
COPY --from=builder --chown=streamlit:streamlit /app/src /app/src
COPY --from=builder --chown=streamlit:streamlit /app/apps/streamlit /app/apps/streamlit

# Ensure the venv is used by default
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER streamlit

# Expose Streamlit port
EXPOSE 8501

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

# Run Streamlit
CMD ["streamlit", "run", "apps/streamlit/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
